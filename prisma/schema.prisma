generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db{
  provider = "mysql"
}
model Game {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(128)

  @@map("games")
}