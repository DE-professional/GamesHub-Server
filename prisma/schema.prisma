// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db{
  provider = "mysql"
}
model Game {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(128)
  scores Score[]

  @@map("games")
}
model User{
  id Int @id @default(autoincrement())
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash") @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(16)
  discriminator Int @db.SmallInt
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  emailVerificationTokens EmailVerificationToken[]
  sessions Session[]
  scores Score[]
  @@unique([displayName, discriminator])
  @@map("users")
}
model EmailVerificationToken{
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  tokenHash Bytes @unique @map("token_hash") @db.Binary(32)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("email_verification_tokens")
}
model Session{
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  tokenHash Bytes @unique @map("token_hash") @db.Binary(32)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}
model Score{
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  gameId Int @map("game_id")
  puzzleDate DateTime @map("puzzle_date") @db.Date
  score Int @db.UnsignedInt
  formulaVersion Int @map("formula_version") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  @@unique([userId, gameId, puzzleDate])
  @@map("scores")
}